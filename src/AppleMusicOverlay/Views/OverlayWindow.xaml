<Window x:Class="AppleMusicOverlay.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:AppleMusicOverlay.Services"
        Width="460.8"
        Height="568.8"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowActivated="False"
        ShowInTaskbar="False"
        Topmost="True"
        Focusable="False">
    <Window.Resources>
        <Style x:Key="PositionEditBarStyle" TargetType="{x:Type Border}">
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Background" Value="#B81B2432" />
            <Setter Property="BorderBrush" Value="#38FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="22"
                                      ShadowDepth="8"
                                      Opacity="0.22"
                                      Color="#000000" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PositionEditButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="Padding" Value="11,3" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="#EAF0F8" />
            <Setter Property="Background" Value="#16FFFFFF" />
            <Setter Property="BorderBrush" Value="#24FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1" />
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonChrome"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="13">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#24FFFFFF" />
                    <Setter Property="BorderBrush" Value="#38FFFFFF" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#30FFFFFF" />
                    <Setter Property="RenderTransform">
                        <Setter.Value>
                            <ScaleTransform ScaleX="0.98" ScaleY="0.98" />
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PositionEditDoneButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource PositionEditButtonStyle}">
            <Setter Property="Foreground" Value="#061017" />
            <Setter Property="Background" Value="#A56ACDDD" />
            <Setter Property="BorderBrush" Value="#90D9F7FF" />
            <Setter Property="Padding" Value="13,3" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#B878D9E8" />
                    <Setter Property="BorderBrush" Value="#BDEBFFFF" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#9360C1D1" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid x:Name="OverlayRoot"
          Opacity="0"
          RenderTransformOrigin="0.5,0.5"
          SnapsToDevicePixels="True">
        <Grid.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="RootScale" ScaleX="0.96" ScaleY="0.96" />
                <TranslateTransform x:Name="RootTranslate" Y="8" />
            </TransformGroup>
        </Grid.RenderTransform>

        <Canvas x:Name="WindowCanvas"
                Width="460.8"
                Height="568.8">
            <Canvas x:Name="AutoHideGroup"
                    Width="460.8"
                    Height="568.8"
                    Opacity="1"
                    IsHitTestVisible="False"
                    RenderTransformOrigin="0.5,0.5">
                <Canvas.RenderTransform>
                    <ScaleTransform x:Name="AutoHideScale"
                                    ScaleX="1"
                                    ScaleY="1" />
                </Canvas.RenderTransform>

                <Canvas x:Name="VisualGroup"
                        Canvas.Left="102.4"
                        Canvas.Top="126.4"
                        Width="256"
                        Height="308"
                        RenderTransformOrigin="0,0"
                        SnapsToDevicePixels="True">
                    <Canvas.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="VisualScale"
                                            CenterX="128"
                                            CenterY="158"
                                            ScaleX="1"
                                            ScaleY="1" />
                            <ScaleTransform x:Name="PositionEditScale"
                                            CenterX="128"
                                            CenterY="158"
                                            ScaleX="1"
                                            ScaleY="1" />
                            <TranslateTransform x:Name="PositionEditTranslate"
                                                Y="0" />
                        </TransformGroup>
                    </Canvas.RenderTransform>

                <Canvas x:Name="ShadowHost"
                        Canvas.Left="0"
                        Canvas.Top="0"
                        Width="256"
                        Height="256"
                        Background="{x:Null}">
                    <Border x:Name="AmbientShadowCaster"
                            Canvas.Left="42"
                            Canvas.Top="42"
                            Width="172"
                            Height="172"
                            Background="#FF000000"
                            CornerRadius="13"
                            IsHitTestVisible="False">
                        <Border.Effect>
                            <DropShadowEffect x:Name="AmbientShadowEffect"
                                              BlurRadius="28"
                                              ShadowDepth="0"
                                              Direction="270"
                                              Opacity="0.18"
                                              Color="#000000" />
                        </Border.Effect>
                    </Border>

                    <Border x:Name="KeyShadowCaster"
                            Canvas.Left="42"
                            Canvas.Top="42"
                            Width="172"
                            Height="172"
                            Background="#FF000000"
                            CornerRadius="13"
                            IsHitTestVisible="False">
                        <Border.Effect>
                            <DropShadowEffect x:Name="KeyShadowEffect"
                                              BlurRadius="32"
                                              ShadowDepth="8"
                                              Direction="270"
                                              Opacity="0.20"
                                              Color="#000000" />
                        </Border.Effect>
                    </Border>

                    <Border x:Name="CoverClip"
                            Canvas.Left="40"
                            Canvas.Top="40"
                            Width="176"
                            Height="176"
                            CornerRadius="13"
                            ClipToBounds="True"
                            MouseLeftButtonDown="CoverClip_MouseLeftButtonDown"
                            MouseMove="CoverClip_MouseMove"
                            MouseLeftButtonUp="CoverClip_MouseLeftButtonUp">
                        <Image x:Name="CoverImage"
                               Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               SizeChanged="CoverImage_SizeChanged" />
                    </Border>
                </Canvas>

                <TextBlock x:Name="TitleText"
                           Canvas.Left="4"
                           Canvas.Top="228"
                           Width="248"
                           Foreground="#F7F7FA"
                           FontFamily="Segoe UI Variable Display, Segoe UI, Microsoft YaHei UI"
                           FontSize="14.2"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"
                           TextAlignment="Center">
                    <TextBlock.Effect>
                        <DropShadowEffect BlurRadius="2"
                                          ShadowDepth="1"
                                          Opacity="0.42"
                                          Color="#111827" />
                    </TextBlock.Effect>
                </TextBlock>

                <TextBlock x:Name="ArtistText"
                           Canvas.Left="4"
                           Canvas.Top="249"
                           Width="248"
                           Foreground="#C8CEDA"
                           FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI"
                           FontSize="12"
                           TextTrimming="CharacterEllipsis"
                           TextAlignment="Center">
                    <TextBlock.Effect>
                        <DropShadowEffect BlurRadius="2"
                                          ShadowDepth="1"
                                          Opacity="0.34"
                                          Color="#111827" />
                    </TextBlock.Effect>
                </TextBlock>
            </Canvas>

            <Border x:Name="PositionEditBar"
                    Canvas.Left="110"
                    Canvas.Top="72"
                    Style="{StaticResource PositionEditBarStyle}"
                    Opacity="0"
                    Visibility="Collapsed"
                    IsHitTestVisible="True"
                    RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <TransformGroup>
                        <TranslateTransform x:Name="PositionEditBarTranslate"
                                            Y="6" />
                        <TranslateTransform x:Name="PositionEditBarInertiaTranslate"
                                            X="0"
                                            Y="0" />
                    </TransformGroup>
                </Border.RenderTransform>
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock x:Name="PositionEditTitleText"
                               Text="{Binding [PositionEditBarTitle], Source={x:Static services:LocalizationService.Current}}"
                               VerticalAlignment="Center"
                               Foreground="#F7F8FB"
                               FontFamily="Segoe UI Variable Text, Segoe UI"
                               FontSize="12.5"
                               FontWeight="SemiBold"
                               Margin="4,0,12,0" />
                    <Button x:Name="PositionEditCancelButton"
                            Content="{Binding [Cancel], Source={x:Static services:LocalizationService.Current}}"
                            Style="{StaticResource PositionEditButtonStyle}"
                            Margin="0,0,6,0"
                            Click="PositionEditCancel_Click" />
                    <Button x:Name="PositionEditDoneButton"
                            Content="{Binding [Done], Source={x:Static services:LocalizationService.Current}}"
                            Style="{StaticResource PositionEditDoneButtonStyle}"
                            Click="PositionEditDone_Click" />
                </StackPanel>
            </Border>
            </Canvas>
        </Canvas>
    </Grid>
</Window>
