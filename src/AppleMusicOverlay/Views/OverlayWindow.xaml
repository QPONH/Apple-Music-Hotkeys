<Window x:Class="AppleMusicOverlay.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="460.8"
        Height="568.8"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowActivated="False"
        ShowInTaskbar="False"
        Topmost="True"
        Focusable="False">
    <Grid x:Name="OverlayRoot"
          Opacity="0"
          RenderTransformOrigin="0.5,0.5"
          SnapsToDevicePixels="True">
        <Grid.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="RootScale" ScaleX="0.96" ScaleY="0.96" />
                <TranslateTransform x:Name="RootTranslate" Y="8" />
            </TransformGroup>
        </Grid.RenderTransform>

        <Canvas x:Name="WindowCanvas"
                Width="460.8"
                Height="568.8">
            <Canvas x:Name="VisualGroup"
                    Canvas.Left="102.4"
                    Canvas.Top="126.4"
                    Width="256"
                    Height="308"
                    RenderTransformOrigin="0,0"
                    SnapsToDevicePixels="True">
                <Canvas.RenderTransform>
                    <ScaleTransform x:Name="VisualScale"
                                    CenterX="128"
                                    CenterY="158"
                                    ScaleX="1"
                                    ScaleY="1" />
                </Canvas.RenderTransform>

                <Canvas x:Name="ShadowHost"
                        Canvas.Left="0"
                        Canvas.Top="0"
                        Width="256"
                        Height="256"
                        Background="Transparent"
                        IsHitTestVisible="False">
                    <Border x:Name="AmbientShadowCaster"
                            Canvas.Left="42"
                            Canvas.Top="42"
                            Width="172"
                            Height="172"
                            Background="#FF000000"
                            CornerRadius="7"
                            IsHitTestVisible="False">
                        <Border.Effect>
                            <DropShadowEffect x:Name="AmbientShadowEffect"
                                              BlurRadius="28"
                                              ShadowDepth="0"
                                              Direction="270"
                                              Opacity="0.18"
                                              Color="#000000" />
                        </Border.Effect>
                    </Border>

                    <Border x:Name="KeyShadowCaster"
                            Canvas.Left="42"
                            Canvas.Top="42"
                            Width="172"
                            Height="172"
                            Background="#FF000000"
                            CornerRadius="7"
                            IsHitTestVisible="False">
                        <Border.Effect>
                            <DropShadowEffect x:Name="KeyShadowEffect"
                                              BlurRadius="32"
                                              ShadowDepth="8"
                                              Direction="270"
                                              Opacity="0.20"
                                              Color="#000000" />
                        </Border.Effect>
                    </Border>

                    <Border x:Name="CoverClip"
                            Canvas.Left="40"
                            Canvas.Top="40"
                            Width="176"
                            Height="176"
                            CornerRadius="9"
                            ClipToBounds="True">
                        <Image x:Name="CoverImage"
                               Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               SizeChanged="CoverImage_SizeChanged" />
                    </Border>
                </Canvas>

                <TextBlock x:Name="TitleText"
                           Canvas.Left="4"
                           Canvas.Top="228"
                           Width="248"
                           Foreground="#F7F7FA"
                           FontFamily="Segoe UI Variable Display, Segoe UI"
                           FontSize="13"
                           FontWeight="DemiBold"
                           TextTrimming="CharacterEllipsis"
                           TextAlignment="Center">
                    <TextBlock.Effect>
                        <DropShadowEffect BlurRadius="2"
                                          ShadowDepth="1"
                                          Opacity="0.42"
                                          Color="#111827" />
                    </TextBlock.Effect>
                </TextBlock>

                <TextBlock x:Name="ArtistText"
                           Canvas.Left="4"
                           Canvas.Top="249"
                           Width="248"
                           Foreground="#C8CEDA"
                           FontFamily="Segoe UI Variable Text, Segoe UI"
                           FontSize="11"
                           TextTrimming="CharacterEllipsis"
                           TextAlignment="Center">
                    <TextBlock.Effect>
                        <DropShadowEffect BlurRadius="2"
                                          ShadowDepth="1"
                                          Opacity="0.34"
                                          Color="#111827" />
                    </TextBlock.Effect>
                </TextBlock>
            </Canvas>
        </Canvas>
    </Grid>
</Window>
