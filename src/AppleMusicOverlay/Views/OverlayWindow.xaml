<Window x:Class="AppleMusicOverlay.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="188"
        Height="232"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowActivated="False"
        ShowInTaskbar="False"
        Topmost="True"
        Focusable="False">
    <Grid x:Name="OverlayRoot"
          Opacity="0"
          RenderTransformOrigin="0.5,0.5"
          SnapsToDevicePixels="True">
        <Grid.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="RootScale" ScaleX="0.96" ScaleY="0.96" />
                <TranslateTransform x:Name="RootTranslate" Y="8" />
            </TransformGroup>
        </Grid.RenderTransform>

        <Border CornerRadius="8"
                Background="#E51B1C22"
                BorderBrush="#36FFFFFF"
                BorderThickness="1"
                Padding="10">
            <Border.Effect>
                <DropShadowEffect BlurRadius="28"
                                  ShadowDepth="10"
                                  Opacity="0.34"
                                  Color="#000000" />
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="168" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border CornerRadius="7"
                        Background="#252733"
                        BorderBrush="#24FFFFFF"
                        BorderThickness="1"
                        ClipToBounds="True">
                    <Image x:Name="CoverImage"
                           Stretch="UniformToFill"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           SizeChanged="CoverImage_SizeChanged" />
                </Border>

                <TextBlock x:Name="TitleText"
                           Grid.Row="1"
                           Margin="2,12,2,0"
                           Foreground="#F7F7FA"
                           FontFamily="Segoe UI Variable Display, Segoe UI"
                           FontSize="13"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"
                           TextAlignment="Center" />

                <TextBlock x:Name="ArtistText"
                           Grid.Row="2"
                           Margin="2,3,2,0"
                           Foreground="#B8BAC4"
                           FontFamily="Segoe UI Variable Text, Segoe UI"
                           FontSize="11"
                           TextTrimming="CharacterEllipsis"
                           TextAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
