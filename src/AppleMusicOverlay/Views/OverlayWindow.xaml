<Window x:Class="AppleMusicOverlay.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="188"
        Height="238"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowActivated="False"
        ShowInTaskbar="False"
        Topmost="True"
        Focusable="False">
    <Grid x:Name="OverlayRoot"
          Opacity="0"
          RenderTransformOrigin="0.5,0.5"
          SnapsToDevicePixels="True">
        <Grid.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="RootScale" ScaleX="0.96" ScaleY="0.96" />
                <TranslateTransform x:Name="RootTranslate" Y="8" />
            </TransformGroup>
        </Grid.RenderTransform>

        <Viewbox Stretch="Fill">
            <Grid Width="188"
                  Height="238">
                <Grid.RowDefinitions>
                    <RowDefinition Height="176" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Width="176"
                        Height="176"
                        HorizontalAlignment="Center"
                        CornerRadius="8"
                        ClipToBounds="True">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="22"
                                          ShadowDepth="8"
                                          Opacity="0.32"
                                          Color="#000000" />
                    </Border.Effect>
                    <Image x:Name="CoverImage"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           SizeChanged="CoverImage_SizeChanged" />
                </Border>

                <TextBlock x:Name="TitleText"
                           Grid.Row="1"
                           Margin="4,13,4,0"
                           Foreground="#F7F7FA"
                           FontFamily="Segoe UI Variable Display, Segoe UI"
                           FontSize="13"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"
                           TextAlignment="Center">
                    <TextBlock.Effect>
                        <DropShadowEffect BlurRadius="8"
                                          ShadowDepth="1"
                                          Opacity="0.72"
                                          Color="#000000" />
                    </TextBlock.Effect>
                </TextBlock>

                <TextBlock x:Name="ArtistText"
                           Grid.Row="2"
                           Margin="4,3,4,0"
                           Foreground="#D5D7DE"
                           FontFamily="Segoe UI Variable Text, Segoe UI"
                           FontSize="11"
                           TextTrimming="CharacterEllipsis"
                           TextAlignment="Center">
                    <TextBlock.Effect>
                        <DropShadowEffect BlurRadius="8"
                                          ShadowDepth="1"
                                          Opacity="0.72"
                                          Color="#000000" />
                    </TextBlock.Effect>
                </TextBlock>
            </Grid>
        </Viewbox>
    </Grid>
</Window>
