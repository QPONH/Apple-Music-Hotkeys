<Application x:Class="AppleMusicOverlay.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Foreground" Value="#F7F8FB" />
            <Setter Property="Background" Value="#2E3542" />
            <Setter Property="BorderBrush" Value="#3C4656" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Foreground" Value="#F7F8FB" />
            <Setter Property="Background" Value="#11151C" />
            <Setter Property="BorderBrush" Value="#303847" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Foreground" Value="#11151C" />
            <Setter Property="Background" Value="#F7F8FB" />
            <Setter Property="BorderBrush" Value="#303847" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#F7F8FB" />
        </Style>
    </Application.Resources>
</Application>
