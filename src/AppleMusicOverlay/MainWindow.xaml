<Window x:Class="AppleMusicOverlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:services="clr-namespace:AppleMusicOverlay.Services"
        xmlns:views="clr-namespace:AppleMusicOverlay.Views"
        Title="MusicFloat"
        Width="960"
        Height="660"
        MinWidth="780"
        MinHeight="540"
        ShowInTaskbar="True"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="{Binding UiFontFamily, Source={x:Static services:LocalizationService.Current}}"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="7"
                            GlassFrameThickness="0"
                            CornerRadius="16"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#0F172A" />
        <SolidColorBrush x:Key="SurfaceBaseBrush" Color="#151C2B" />
        <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#1B2336" />
        <SolidColorBrush x:Key="SurfaceControlBrush" Color="#202A3B" />
        <SolidColorBrush x:Key="SurfaceControlHoverBrush" Color="#263246" />
        <SolidColorBrush x:Key="SurfaceControlPressedBrush" Color="#141B29" />
        <SolidColorBrush x:Key="BorderSubtleBrush" Color="#263246" />
        <SolidColorBrush x:Key="BorderSoftBrush" Color="#20283A" />
        <SolidColorBrush x:Key="BorderFocusBrush" Color="#5BA7B8" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F8FAFC" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A8B3C4" />
        <SolidColorBrush x:Key="TextMutedBrush" Color="#718096" />
        <SolidColorBrush x:Key="AccentBrush" Color="#5BA7B8" />
        <SolidColorBrush x:Key="AccentMutedBrush" Color="#234757" />
        <SolidColorBrush x:Key="SuccessBrush" Color="#7DBE8C" />
        <SolidColorBrush x:Key="DangerBrush" Color="#E06C75" />

        <Style x:Key="PageTitleStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="FontFamily" Value="{Binding UiFontFamily, Source={x:Static services:LocalizationService.Current}}" />
            <Setter Property="FontSize" Value="23" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="FontFamily" Value="{Binding UiFontFamily, Source={x:Static services:LocalizationService.Current}}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="BodyTextStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="LineHeight" Value="19" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="CaptionTextStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="LineHeight" Value="18" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="ValueTextStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="CardStyle" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{StaticResource SurfaceBaseBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="20" />
        </Style>

        <Style x:Key="RaisedCardStyle" TargetType="{x:Type Border}" BasedOn="{StaticResource CardStyle}">
            <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
        </Style>

        <Style x:Key="StatusPillStyle" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="#1F3342" />
            <Setter Property="BorderBrush" Value="#355B69" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="38" />
            <Setter Property="MinWidth" Value="86" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="{StaticResource SurfaceControlBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                SnapsToDevicePixels="True">
                            <ContentPresenter x:Name="ContentHost"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True">
                                <ContentPresenter.RenderTransform>
                                    <ScaleTransform ScaleX="1" ScaleY="1" />
                                </ContentPresenter.RenderTransform>
                            </ContentPresenter>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource SurfaceControlHoverBrush}" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="#3A485F" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource SurfaceControlPressedBrush}" />
                                <Setter TargetName="ContentHost" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.97" ScaleY="0.97" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Foreground" Value="#071216" />
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="#7FC0CB" />
        </Style>

        <Style x:Key="TransportButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Height" Value="40" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style x:Key="WindowButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource SurfaceControlBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource SurfaceControlPressedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type TextBox}">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="{StaticResource SurfaceControlBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource SurfaceControlHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource BorderFocusBrush}" />
                                <Setter TargetName="Root" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ComboBoxItem}">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                        <Border x:Name="Root"
                                Background="Transparent"
                                CornerRadius="9"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource SurfaceControlHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource AccentMutedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ComboBox}">
            <Setter Property="Height" Value="40" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="{StaticResource SurfaceControlBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="13,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBox}">
                        <Grid>
                            <Border x:Name="Input"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="10" />
                            <ToggleButton x:Name="ToggleButton"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                                        <Border Background="{TemplateBinding Background}">
                                            <ContentPresenter HorizontalAlignment="Stretch"
                                                              VerticalAlignment="Stretch" />
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <Grid Margin="{TemplateBinding Padding}">
                                    <TextBlock x:Name="SelectionText"
                                               Margin="0,0,28,0"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Left"
                                               Foreground="{TemplateBinding Foreground}"
                                               Text="{Binding SelectedItem.DisplayName, RelativeSource={RelativeSource TemplatedParent}}"
                                               TextTrimming="CharacterEllipsis" />
                                    <Path x:Name="DropDownArrow"
                                          Width="10"
                                          Height="6"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Center"
                                          Data="M 0 0 L 5 5 L 10 0"
                                          Stroke="{StaticResource TextSecondaryBrush}"
                                          StrokeThickness="1.8"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round" />
                                </Grid>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   PopupAnimation="Fade">
                                <Border Margin="0,8,0,0"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="230"
                                        Background="#111827"
                                        BorderBrush="{StaticResource BorderSubtleBrush}"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="6">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="22"
                                                          ShadowDepth="8"
                                                          Opacity="0.34"
                                                          Color="#000000" />
                                    </Border.Effect>
                                    <ScrollViewer CanContentScroll="True">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger SourceName="ToggleButton" Property="IsMouseOver" Value="True">
                                <Setter TargetName="Input" Property="Background" Value="{StaticResource SurfaceControlHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="Input" Property="BorderBrush" Value="{StaticResource BorderFocusBrush}" />
                                <Setter TargetName="Input" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Input" Property="BorderBrush" Value="{StaticResource BorderFocusBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Input" Property="Background" Value="{StaticResource SurfaceControlBrush}" />
                                <Setter TargetName="Input" Property="BorderBrush" Value="{StaticResource BorderSoftBrush}" />
                                <Setter TargetName="SelectionText" Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                                <Setter TargetName="DropDownArrow" Property="Stroke" Value="{StaticResource TextMutedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type CheckBox}">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CheckBox}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                            <Border x:Name="Track"
                                    Grid.Column="1"
                                    Width="42"
                                    Height="24"
                                    Margin="14,0,0,0"
                                    Background="{StaticResource SurfaceControlBrush}"
                                    BorderBrush="{StaticResource BorderSubtleBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12">
                                <Ellipse x:Name="Thumb"
                                         Width="18"
                                         Height="18"
                                         Margin="3,0,0,0"
                                         HorizontalAlignment="Left"
                                         VerticalAlignment="Center"
                                         Fill="{StaticResource TextSecondaryBrush}" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource SurfaceControlHoverBrush}" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="#3A485F" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource BorderFocusBrush}" />
                                <Setter TargetName="Track" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource AccentMutedBrush}" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource BorderFocusBrush}" />
                                <Setter TargetName="Thumb" Property="Fill" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Thumb" Property="Opacity" Value="0.78" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type Slider}">
            <Setter Property="Height" Value="34" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Slider}">
                        <Grid Margin="2,0"
                              ClipToBounds="False">
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton IsTabStop="False"
                                                  Command="{x:Static Slider.DecreaseLarge}"
                                                  CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="{x:Type RepeatButton}">
                                                <Border Height="5"
                                                        VerticalAlignment="Center"
                                                        Background="{StaticResource AccentMutedBrush}"
                                                        CornerRadius="3"
                                                        Opacity="0.92" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton IsTabStop="False"
                                                  Command="{x:Static Slider.IncreaseLarge}"
                                                  CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="{x:Type RepeatButton}">
                                                <Border Height="5"
                                                        VerticalAlignment="Center"
                                                        Background="#182033"
                                                        CornerRadius="3" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="24"
                                           Height="24">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Border x:Name="ThumbRoot"
                                                        Width="18"
                                                        Height="18"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Background="{StaticResource SurfaceRaisedBrush}"
                                                        BorderBrush="{StaticResource BorderFocusBrush}"
                                                        BorderThickness="2"
                                                        CornerRadius="9">
                                                    <Border.Effect>
                                                        <DropShadowEffect BlurRadius="9"
                                                                          ShadowDepth="0"
                                                                          Opacity="0.16"
                                                                          Color="#5BA7B8" />
                                                    </Border.Effect>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbRoot" Property="Background" Value="#223047" />
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="ThumbRoot" Property="Background" Value="{StaticResource AccentMutedBrush}" />
                                                        <Setter TargetName="ThumbRoot" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RoundedScrollBarStyle" TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="10" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid x:Name="Root"
                              Width="{TemplateBinding Width}"
                              Background="Transparent">
                            <Border Width="6"
                                    HorizontalAlignment="Center"
                                    Background="#121A29"
                                    CornerRadius="3"
                                    Opacity="0.75" />
                            <Track x:Name="PART_Track"
                                   IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"
                                                  Focusable="False"
                                                  Opacity="0">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="{x:Type RepeatButton}">
                                                <Border Background="Transparent" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"
                                                  Focusable="False"
                                                  Opacity="0">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="{x:Type RepeatButton}">
                                                <Border Background="Transparent" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb MinHeight="48">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Border x:Name="ThumbRoot"
                                                        Width="6"
                                                        HorizontalAlignment="Center"
                                                        Background="#40516A"
                                                        CornerRadius="3"
                                                        Opacity="0.82" />
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbRoot" Property="Background" Value="{StaticResource BorderFocusBrush}" />
                                                        <Setter TargetName="ThumbRoot" Property="Opacity" Value="1" />
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="ThumbRoot" Property="Background" Value="{StaticResource AccentBrush}" />
                                                        <Setter TargetName="ThumbRoot" Property="Opacity" Value="1" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource RoundedScrollBarStyle}" />

        <Style x:Key="PanelScrollViewerStyle" TargetType="{x:Type ScrollViewer}">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        </Style>

        <Style x:Key="ExpandableNavigationCardStyle" TargetType="{x:Type views:ExpandableNavigationCard}">
            <Setter Property="Width" Value="180" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type views:ExpandableNavigationCard}">
                        <Border x:Name="PART_HeaderRoot"
                                Padding="14,11"
                                CornerRadius="10">
                            <Border.Style>
                                <Style TargetType="{x:Type Border}">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type TabItem}}}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource SurfaceControlBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type TabItem}}}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource AccentMutedBrush}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource BorderFocusBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsKeyboardFocused, RelativeSource={RelativeSource AncestorType={x:Type TabItem}}}" Value="True">
                                            <Setter Property="BorderBrush" Value="{StaticResource BorderFocusBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <StackPanel>
                                <TextBlock Text="{TemplateBinding Header}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="{x:Type TextBlock}">
                                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type TabItem}}}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type TabItem}}}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <Border x:Name="ExpansionHost"
                                        Margin="0,10,0,0"
                                        MaxHeight="0"
                                        Visibility="Collapsed"
                                        Opacity="0"
                                        ClipToBounds="True"
                                        RenderTransformOrigin="0.5,0">
                                    <Border.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform x:Name="ExpansionScale"
                                                            ScaleX="1"
                                                            ScaleY="0.92" />
                                            <TranslateTransform x:Name="ExpansionTranslate"
                                                                Y="-8" />
                                        </TransformGroup>
                                    </Border.RenderTransform>
                                    <Grid x:Name="ExpansionContentHost">
                                        <StackPanel x:Name="DefaultExpansionContent">
                                            <StackPanel.Style>
                                                <Style TargetType="{x:Type StackPanel}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <Border Height="1"
                                                    Margin="0,0,0,10"
                                                    Background="{StaticResource BorderFocusBrush}"
                                                    Opacity="0.55" />
                                            <TextBlock Text="{TemplateBinding ExpansionTitle}"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="{TemplateBinding ExpansionMessage}"
                                                       Margin="0,6,0,0"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       FontSize="12"
                                                       FontWeight="Normal"
                                                       LineHeight="17"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>

                                        <ContentPresenter x:Name="ExpansionContentPresenter"
                                                          Content="{TemplateBinding Content}">
                                            <ContentPresenter.Style>
                                                <Style TargetType="{x:Type ContentPresenter}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ContentPresenter.Style>
                                        </ContentPresenter>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavigationTabControlStyle" TargetType="{x:Type TabControl}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="TabStripPlacement" Value="Left" />
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <StackPanel />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabControl}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="202" />
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Background="{StaticResource SurfaceBaseBrush}"
                                    BorderBrush="{StaticResource BorderSubtleBrush}"
                                    BorderThickness="1"
                                    CornerRadius="14"
                                    Padding="10">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="12" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <StackPanel Margin="4,4,4,0">
                                        <TextBlock Text="{Binding [ControlPanelTitle], Source={x:Static services:LocalizationService.Current}}"
                                                   Style="{StaticResource SectionTitleStyle}" />
                                        <TextBlock Text="{Binding [ControlPanelDescription], Source={x:Static services:LocalizationService.Current}}"
                                                   Margin="0,4,0,0"
                                                   Style="{StaticResource CaptionTextStyle}" />
                                    </StackPanel>

                                    <StackPanel x:Name="HeaderPanel"
                                                Grid.Row="2"
                                                IsItemsHost="True"
                                                KeyboardNavigation.TabIndex="1"
                                                Background="Transparent" />

                                    <Border Grid.Row="3"
                                            Margin="4,12,4,0"
                                            Background="#101827"
                                            BorderBrush="{StaticResource BorderSoftBrush}"
                                            BorderThickness="1"
                                            CornerRadius="12"
                                            Padding="12">
                                        <StackPanel>
                                            <TextBlock Text="{Binding [CurrentStatus], Source={x:Static services:LocalizationService.Current}}"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding StatusText}"
                                                       Margin="0,6,0,0"
                                                       Style="{StaticResource BodyTextStyle}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>

                            <Border Grid.Column="2"
                                    Background="Transparent">
                                <ContentPresenter x:Name="PART_SelectedContentHost"
                                                  ContentSource="SelectedContent"
                                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type TabItem}">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Width" Value="180" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabItem}">
                        <ContentPresenter ContentSource="Header"
                                          RecognizesAccessKey="True"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Center" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FadePageStyle" TargetType="{x:Type Grid}">
            <Setter Property="Opacity" Value="0" />
            <Style.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                             To="1"
                                             Duration="0:0:0.16" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border x:Name="WindowFrame"
            Background="{StaticResource WindowBackgroundBrush}"
            BorderBrush="{StaticResource BorderSubtleBrush}"
            BorderThickness="1"
            CornerRadius="20"
            Margin="0"
            ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="64" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  Background="Transparent"
                  Margin="22,12,14,6"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="MusicFloat"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontFamily="Segoe UI Variable Display, Segoe UI"
                                   FontSize="20"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{Binding [AppSubtitle], Source={x:Static services:LocalizationService.Current}}"
                                   Margin="0,1,0,0"
                                   Style="{StaticResource CaptionTextStyle}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Content="{Binding [Refresh], Source={x:Static services:LocalizationService.Current}}"
                            Width="86"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Margin="0,0,8,0"
                            Click="Refresh_Click" />
                    <Button Content="{Binding [TestOverlay], Source={x:Static services:LocalizationService.Current}}"
                            Width="120"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Margin="0,0,12,0"
                            Click="ShowCurrentTrack_Click" />
                    <Button Content="&#xE921;"
                            Style="{StaticResource WindowButtonStyle}"
                            Click="Minimize_Click" />
                    <Button x:Name="MaximizeButton"
                            Content="&#xE922;"
                            Style="{StaticResource WindowButtonStyle}"
                            Click="Maximize_Click" />
                    <Button Content="&#xE8BB;"
                            Style="{StaticResource WindowButtonStyle}"
                            Click="Close_Click" />
                </StackPanel>
            </Grid>

            <TabControl Grid.Row="1"
                        Margin="22,8,22,22"
                        Style="{StaticResource NavigationTabControlStyle}">
                <TabItem>
                    <TabItem.Header>
                        <views:ExpandableNavigationCard x:Name="CurrentNavigationCard"
                                                        Header="{Binding [NavCurrent], Source={x:Static services:LocalizationService.Current}}"
                                                        Style="{StaticResource ExpandableNavigationCardStyle}" />
                    </TabItem.Header>
                    <ScrollViewer Style="{StaticResource PanelScrollViewerStyle}">
                        <Grid Style="{StaticResource FadePageStyle}"
                              PreviewMouseDown="HotkeyPage_PreviewMouseDown">
                            <StackPanel>
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding [CurrentPageTitle], Source={x:Static services:LocalizationService.Current}}"
                                                   Style="{StaticResource PageTitleStyle}" />
                                        <TextBlock Text="{Binding [CurrentPageDescription], Source={x:Static services:LocalizationService.Current}}"
                                                   Margin="0,5,0,0"
                                                   Style="{StaticResource BodyTextStyle}" />
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Content="{Binding [RefreshSources], Source={x:Static services:LocalizationService.Current}}"
                                            Width="118"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            VerticalAlignment="Center"
                                            Click="RefreshSources_Click" />
                                </Grid>

                                <Border Style="{StaticResource RaisedCardStyle}"
                                        Margin="0,0,0,14">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <Border Style="{StaticResource StatusPillStyle}">
                                            <TextBlock Text="{Binding StatusText}"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold" />
                                        </Border>

                                        <TextBlock Grid.Row="1"
                                                   Text="{Binding CurrentTitle}"
                                                   Margin="0,22,0,0"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   FontFamily="Segoe UI Variable Display, Segoe UI"
                                                   FontSize="28"
                                                   FontWeight="SemiBold"
                                                   LineHeight="34"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Grid.Row="2"
                                                   Text="{Binding CurrentArtist}"
                                                   Margin="0,7,0,0"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   FontSize="15"
                                                   TextWrapping="Wrap" />

                                        <Grid Grid.Row="3"
                                              Margin="0,26,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="10" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="10" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Button Content="{Binding [PreviousTrack], Source={x:Static services:LocalizationService.Current}}"
                                                    Style="{StaticResource TransportButtonStyle}"
                                                    Click="Previous_Click" />
                                            <Button Grid.Column="2"
                                                    Content="{Binding TransportButtonText}"
                                                    Style="{StaticResource TransportButtonStyle}"
                                                    Click="Toggle_Click" />
                                            <Button Grid.Column="4"
                                                    Content="{Binding [NextTrack], Source={x:Static services:LocalizationService.Current}}"
                                                    Style="{StaticResource TransportButtonStyle}"
                                                    Click="Next_Click" />
                                        </Grid>
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource CardStyle}"
                                        Margin="0,0,0,14">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="12" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="12" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding [CaptureSource], Source={x:Static services:LocalizationService.Current}}"
                                                           Style="{StaticResource SectionTitleStyle}" />
                                                <TextBlock Text="{Binding [CaptureSourceDescription], Source={x:Static services:LocalizationService.Current}}"
                                                           Margin="0,5,0,0"
                                                           Style="{StaticResource BodyTextStyle}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1"
                                                       Text="SMTC"
                                                       Foreground="{StaticResource AccentBrush}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Top" />
                                        </Grid>
                                        <ComboBox x:Name="CaptureSourceCombo"
                                                  Grid.Row="2"
                                                  ItemsSource="{Binding CaptureSources}"
                                                  DisplayMemberPath="DisplayName"
                                                  SelectedValuePath="SourceAppUserModelId"
                                                  SelectedValue="{Binding Settings.CaptureSourceAppUserModelId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  SelectionChanged="CaptureSourceCombo_SelectionChanged" />
                                        <TextBlock Grid.Row="4"
                                                   Text="{Binding [CaptureSourceHint], Source={x:Static services:LocalizationService.Current}}"
                                                   Style="{StaticResource CaptionTextStyle}" />
                                    </Grid>
                                </Border>

                            </StackPanel>
                            <Border x:Name="LegacyHotkeyCapturePanel"
                                    Panel.ZIndex="20"
                                    Width="360"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Margin="0,44,0,0"
                                    Background="{StaticResource SurfaceRaisedBrush}"
                                    BorderBrush="{StaticResource BorderFocusBrush}"
                                    BorderThickness="1"
                                    CornerRadius="14"
                                    Padding="16"
                                    Visibility="Collapsed"
                                    IsHitTestVisible="False">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="26"
                                                      ShadowDepth="8"
                                                      Opacity="0.32"
                                                      Color="#000000" />
                                </Border.Effect>
                                <StackPanel x:Name="LegacyHotkeyCaptureContent">
                                    <TextBlock Text="{Binding [HotkeyEditTitle], Source={x:Static services:LocalizationService.Current}}"
                                               Style="{StaticResource SectionTitleStyle}" />
                                    <TextBlock x:Name="LegacyHotkeyCaptureStatusText"
                                               Margin="0,6,0,0"
                                               Style="{StaticResource BodyTextStyle}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </ScrollViewer>
                </TabItem>

                <TabItem>
                    <TabItem.Header>
                        <views:ExpandableNavigationCard x:Name="OverlayNavigationCard"
                                                        Header="{Binding [NavOverlay], Source={x:Static services:LocalizationService.Current}}"
                                                        Style="{StaticResource ExpandableNavigationCardStyle}" />
                    </TabItem.Header>
                    <ScrollViewer Style="{StaticResource PanelScrollViewerStyle}">
                        <Grid Style="{StaticResource FadePageStyle}">
                            <StackPanel>
                                <TextBlock Text="{Binding [OverlayPageTitle], Source={x:Static services:LocalizationService.Current}}"
                                           Style="{StaticResource PageTitleStyle}" />
                                <TextBlock Text="{Binding [OverlayPageDescription], Source={x:Static services:LocalizationService.Current}}"
                                           Margin="0,5,0,16"
                                           Style="{StaticResource BodyTextStyle}" />

                                <Border Style="{StaticResource CardStyle}"
                                        Margin="0,0,0,14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="260" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding [CoverShadowSize], Source={x:Static services:LocalizationService.Current}}"
                                                       Style="{StaticResource SectionTitleStyle}" />
                                            <TextBlock Text="{Binding [CoverShadowSizeDescription], Source={x:Static services:LocalizationService.Current}}"
                                                       Margin="0,5,0,0"
                                                       Style="{StaticResource BodyTextStyle}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ElementName=CoverShadowSizeSlider, Path=Value, StringFormat={}{0:0}%}"
                                                       HorizontalAlignment="Right"
                                                       Style="{StaticResource ValueTextStyle}" />
                                            <Slider x:Name="CoverShadowSizeSlider"
                                                    Margin="0,7,0,0"
                                                    Minimum="0"
                                                    Maximum="100"
                                                    TickFrequency="0.5"
                                                    Value="{Binding Settings.CoverShadowSizePercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    ValueChanged="OverlaySettingSlider_ValueChanged" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource CardStyle}"
                                        Margin="0,0,0,14">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="1" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="260" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding [DisplaySeconds], Source={x:Static services:LocalizationService.Current}}"
                                                           Style="{StaticResource SectionTitleStyle}" />
                                                <TextBlock Text="{Binding [DisplaySecondsDescription], Source={x:Static services:LocalizationService.Current}}"
                                                           Margin="0,5,0,0"
                                                           Style="{StaticResource BodyTextStyle}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1"
                                                        VerticalAlignment="Center">
                                                <TextBlock x:Name="DisplaySecondsValueText"
                                                           HorizontalAlignment="Right"
                                                           Style="{StaticResource ValueTextStyle}" />
                                                <Slider x:Name="DisplaySecondsSlider"
                                                        Margin="0,7,0,0"
                                                        Minimum="1"
                                                        Maximum="10"
                                                        TickFrequency="1"
                                                        IsSnapToTickEnabled="True"
                                                        Value="{Binding Settings.DisplaySeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                        ValueChanged="OverlaySettingSlider_ValueChanged" />
                                            </StackPanel>
                                        </Grid>

                                        <Border Grid.Row="1"
                                                Margin="0,18"
                                                Background="{StaticResource BorderSoftBrush}" />

                                        <Grid Grid.Row="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="260" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding [ScalePercent], Source={x:Static services:LocalizationService.Current}}"
                                                           Style="{StaticResource SectionTitleStyle}" />
                                                <TextBlock Text="{Binding [ScalePercentDescription], Source={x:Static services:LocalizationService.Current}}"
                                                           Margin="0,5,0,0"
                                                           Style="{StaticResource BodyTextStyle}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ElementName=ScaleSlider, Path=Value, StringFormat={}{0:0}%}"
                                                           HorizontalAlignment="Right"
                                                           Style="{StaticResource ValueTextStyle}" />
                                                <Slider x:Name="ScaleSlider"
                                                        Margin="0,7,0,0"
                                                        Minimum="70"
                                                        Maximum="180"
                                                        TickFrequency="0.5"
                                                        Value="{Binding Settings.ScalePercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                        ValueChanged="OverlaySettingSlider_ValueChanged" />
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource CardStyle}">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding [DisplayBehavior], Source={x:Static services:LocalizationService.Current}}"
                                                           Style="{StaticResource SectionTitleStyle}" />
                                                <TextBlock Text="{Binding [DisplayBehaviorDescription], Source={x:Static services:LocalizationService.Current}}"
                                                           Margin="0,5,0,0"
                                                           Style="{StaticResource BodyTextStyle}" />
                                            </StackPanel>
                                            <Border Grid.Column="1"
                                                    Style="{StaticResource StatusPillStyle}"
                                                    VerticalAlignment="Top">
                                                <TextBlock Text="{Binding [PinnedBadge], Source={x:Static services:LocalizationService.Current}}"
                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold" />
                                            </Border>
                                        </Grid>
                                        <CheckBox Content="{Binding [PauseOverlay], Source={x:Static services:LocalizationService.Current}}"
                                                  Margin="0,18,0,0"
                                                  IsChecked="{Binding Settings.PauseOverlay, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  Checked="PauseOverlay_Changed"
                                                  Unchecked="PauseOverlay_Changed" />
                                        <Border Margin="0,14"
                                                Background="{StaticResource BorderSoftBrush}"
                                                Height="1" />
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="14" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="14" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid x:Name="PauseOverlayDependentSettings"
                                                  Grid.RowSpan="3"
                                                  IsEnabled="{Binding Settings.PauseOverlay}"
                                                  ToolTip="{Binding [PauseOverlayRequired], Source={x:Static services:LocalizationService.Current}}">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="14" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding [AutoHideOnMouseNear], Source={x:Static services:LocalizationService.Current}}"
                                                                   Style="{StaticResource SectionTitleStyle}" />
                                                        <TextBlock Text="{Binding [AutoHideOnMouseNearDescription], Source={x:Static services:LocalizationService.Current}}"
                                                                   Margin="0,5,0,0"
                                                                   Style="{StaticResource BodyTextStyle}" />
                                                        <TextBlock Text="{Binding [PauseOverlayRequired], Source={x:Static services:LocalizationService.Current}}"
                                                                   Margin="0,5,0,0"
                                                                   Style="{StaticResource CaptionTextStyle}" />
                                                    </StackPanel>
                                                    <CheckBox Grid.Column="1"
                                                              VerticalAlignment="Center"
                                                              IsChecked="{Binding Settings.AutoHideOnMouseNear, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                              Checked="MouseAutoHide_Changed"
                                                              Unchecked="MouseAutoHide_Changed" />
                                                </Grid>
                                                <Grid Grid.Row="2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding [OverlayPosition], Source={x:Static services:LocalizationService.Current}}"
                                                                   Style="{StaticResource SectionTitleStyle}" />
                                                        <TextBlock Text="{Binding [OverlayPositionDescription], Source={x:Static services:LocalizationService.Current}}"
                                                                   Margin="0,5,0,0"
                                                                   Style="{StaticResource BodyTextStyle}" />
                                                        <TextBlock Text="{Binding [PauseOverlayRequired], Source={x:Static services:LocalizationService.Current}}"
                                                                   Margin="0,5,0,0"
                                                                   Style="{StaticResource CaptionTextStyle}" />
                                                    </StackPanel>
                                                    <Button Grid.Column="1"
                                                            Content="{Binding [AdjustPosition], Source={x:Static services:LocalizationService.Current}}"
                                                            Width="126"
                                                            Style="{StaticResource SecondaryButtonStyle}"
                                                            VerticalAlignment="Center"
                                                            Click="PositionOverlay_Click" />
                                                </Grid>
                                            </Grid>
                                            <Border Grid.Row="3"
                                                    Margin="0,14"
                                                    Background="{StaticResource BorderSoftBrush}"
                                                    Height="1" />
                                            <Grid x:Name="OverlayContentSettings"
                                                  Grid.Row="4">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="14" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="18" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <CheckBox Content="{Binding [ShowTitle], Source={x:Static services:LocalizationService.Current}}"
                                                          IsChecked="{Binding Settings.ShowTitle}"
                                                          Checked="OverlayTextOption_Changed"
                                                          Unchecked="OverlayTextOption_Changed" />
                                                <CheckBox Grid.Row="2"
                                                          Content="{Binding [ShowArtist], Source={x:Static services:LocalizationService.Current}}"
                                                          IsChecked="{Binding Settings.ShowArtist}"
                                                          Checked="OverlayTextOption_Changed"
                                                          Unchecked="OverlayTextOption_Changed" />
                                                <Grid Grid.Row="4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="330" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding [OverlayTrackFont], Source={x:Static services:LocalizationService.Current}}"
                                                                   Style="{StaticResource BodyTextStyle}" />
                                                        <TextBlock Text="{Binding [OverlayTrackFontDescription], Source={x:Static services:LocalizationService.Current}}"
                                                                   Margin="0,5,0,0"
                                                                   Style="{StaticResource CaptionTextStyle}" />
                                                    </StackPanel>
                                                    <ComboBox x:Name="OverlayTrackFontCombo"
                                                              Grid.Column="1"
                                                              Width="330"
                                                              HorizontalAlignment="Right"
                                                              VerticalAlignment="Center"
                                                              DisplayMemberPath="DisplayName"
                                                              SelectedValuePath="Id"
                                                              SelectedValue="{Binding Settings.OverlayTrackFont, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                              SelectionChanged="OverlayTrackFontCombo_SelectionChanged" />
                                                </Grid>
                                            </Grid>
                                        </Grid>
                                    </StackPanel>
                                </Border>


                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </TabItem>

                <TabItem>
                    <TabItem.Header>
                        <views:ExpandableNavigationCard x:Name="HotkeyNavigationCard"
                                                        Header="{Binding [NavShortcuts], Source={x:Static services:LocalizationService.Current}}"
                                                        Style="{StaticResource ExpandableNavigationCardStyle}">
                            <Border x:Name="HotkeyCapturePanel">
                                <StackPanel x:Name="HotkeyCaptureContent">
                                    <Border Height="1"
                                            Margin="0,0,0,10"
                                            Background="{StaticResource BorderFocusBrush}"
                                            Opacity="0.55" />
                                    <TextBlock x:Name="HotkeyCaptureTitleText"
                                               Text="{Binding [HotkeyEditTitle], Source={x:Static services:LocalizationService.Current}}"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               FontSize="12"
                                               FontWeight="SemiBold" />
                                    <TextBlock x:Name="HotkeyCaptureStatusText"
                                               Margin="0,6,0,0"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               FontSize="12"
                                               FontWeight="Normal"
                                               LineHeight="17"
                                               TextWrapping="Wrap" />
                                    <StackPanel x:Name="HotkeyCaptureActionsPanel"
                                                Margin="0,10,0,0"
                                                Orientation="Vertical"
                                                Visibility="Collapsed">
                                        <Button x:Name="GamepadCapturePrimaryButton"
                                                Height="30"
                                                Margin="0,0,0,6"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                Click="GamepadCapturePrimary_Click" />
                                        <Button x:Name="GamepadCaptureSecondaryButton"
                                                Height="30"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Click="GamepadCaptureSecondary_Click" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </views:ExpandableNavigationCard>
                    </TabItem.Header>
                    <ScrollViewer Style="{StaticResource PanelScrollViewerStyle}">
                        <Grid Style="{StaticResource FadePageStyle}">
                            <StackPanel>
                                <TextBlock Text="{Binding [ShortcutsPageTitle], Source={x:Static services:LocalizationService.Current}}"
                                           Style="{StaticResource PageTitleStyle}" />
                                <TextBlock Text="{Binding [ShortcutsPageDescription], Source={x:Static services:LocalizationService.Current}}"
                                           Margin="0,5,0,16"
                                           Style="{StaticResource BodyTextStyle}" />

                                <Border Style="{StaticResource CardStyle}"
                                        Margin="0,0,0,14">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="1" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="1" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="1" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="170" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding [PreviousTrack], Source={x:Static services:LocalizationService.Current}}"
                                                           Style="{StaticResource ValueTextStyle}" />
                                                <TextBlock Text="{Binding [PreviousTrackDescription], Source={x:Static services:LocalizationService.Current}}"
                                                           Margin="0,4,0,0"
                                                           Style="{StaticResource CaptionTextStyle}" />
                                            </StackPanel>
                                            <TextBox x:Name="KeyboardPreviousBox"
                                                     Grid.Column="1"
                                                     Tag="KeyboardPrevious"
                                                     IsReadOnly="True"
                                                     Focusable="False"
                                                     Cursor="Hand"
                                                     Text="{Binding Settings.KeyboardPrevious, Mode=OneWay}"
                                                     PreviewMouseDown="HotkeyBox_PreviewMouseDown"
                                                     LostKeyboardFocus="HotkeyBox_LostKeyboardFocus"
                                                     PreviewKeyDown="HotkeyBox_PreviewKeyDown"
                                                     PreviewKeyUp="HotkeyBox_PreviewKeyUp" />
                                            <Button Grid.Column="2"
                                                    Content="{Binding [Delete], Source={x:Static services:LocalizationService.Current}}"
                                                    Tag="KeyboardPrevious"
                                                    Width="62"
                                                    Height="38"
                                                    Margin="10,0,0,0"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    Click="DeleteHotkey_Click" />
                                        </Grid>

                                        <Border Grid.Row="1"
                                                Margin="0,14"
                                                Background="{StaticResource BorderSoftBrush}" />

                                        <Grid Grid.Row="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="170" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding [NextTrack], Source={x:Static services:LocalizationService.Current}}"
                                                           Style="{StaticResource ValueTextStyle}" />
                                                <TextBlock Text="{Binding [NextTrackDescription], Source={x:Static services:LocalizationService.Current}}"
                                                           Margin="0,4,0,0"
                                                           Style="{StaticResource CaptionTextStyle}" />
                                            </StackPanel>
                                            <TextBox x:Name="KeyboardNextBox"
                                                     Grid.Column="1"
                                                     Tag="KeyboardNext"
                                                     IsReadOnly="True"
                                                     Focusable="False"
                                                     Cursor="Hand"
                                                     Text="{Binding Settings.KeyboardNext, Mode=OneWay}"
                                                     PreviewMouseDown="HotkeyBox_PreviewMouseDown"
                                                     LostKeyboardFocus="HotkeyBox_LostKeyboardFocus"
                                                     PreviewKeyDown="HotkeyBox_PreviewKeyDown"
                                                     PreviewKeyUp="HotkeyBox_PreviewKeyUp" />
                                            <Button Grid.Column="2"
                                                    Content="{Binding [Delete], Source={x:Static services:LocalizationService.Current}}"
                                                    Tag="KeyboardNext"
                                                    Width="62"
                                                    Height="38"
                                                    Margin="10,0,0,0"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    Click="DeleteHotkey_Click" />
                                        </Grid>

                                        <Border Grid.Row="3"
                                                Margin="0,14"
                                                Background="{StaticResource BorderSoftBrush}" />

                                        <Grid Grid.Row="4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="170" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding [TogglePlayPause], Source={x:Static services:LocalizationService.Current}}"
                                                           Style="{StaticResource ValueTextStyle}" />
                                                <TextBlock Text="{Binding [TogglePlayPauseDescription], Source={x:Static services:LocalizationService.Current}}"
                                                           Margin="0,4,0,0"
                                                           Style="{StaticResource CaptionTextStyle}" />
                                            </StackPanel>
                                            <TextBox x:Name="KeyboardToggleBox"
                                                     Grid.Column="1"
                                                     Tag="KeyboardToggle"
                                                     IsReadOnly="True"
                                                     Focusable="False"
                                                     Cursor="Hand"
                                                     Text="{Binding Settings.KeyboardToggle, Mode=OneWay}"
                                                     PreviewMouseDown="HotkeyBox_PreviewMouseDown"
                                                     LostKeyboardFocus="HotkeyBox_LostKeyboardFocus"
                                                     PreviewKeyDown="HotkeyBox_PreviewKeyDown"
                                                     PreviewKeyUp="HotkeyBox_PreviewKeyUp" />
                                            <Button Grid.Column="2"
                                                    Content="{Binding [Delete], Source={x:Static services:LocalizationService.Current}}"
                                                    Tag="KeyboardToggle"
                                                    Width="62"
                                                    Height="38"
                                                    Margin="10,0,0,0"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    Click="DeleteHotkey_Click" />
                                        </Grid>

                                        <Border Grid.Row="5"
                                                Margin="0,14"
                                                Background="{StaticResource BorderSoftBrush}" />

                                        <Grid Grid.Row="6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="170" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding [ShowOverlay], Source={x:Static services:LocalizationService.Current}}"
                                                           Style="{StaticResource ValueTextStyle}" />
                                                <TextBlock Text="{Binding [ShowOverlayDescription], Source={x:Static services:LocalizationService.Current}}"
                                                           Margin="0,4,0,0"
                                                           Style="{StaticResource CaptionTextStyle}" />
                                            </StackPanel>
                                            <TextBox x:Name="KeyboardTestOverlayBox"
                                                     Grid.Column="1"
                                                     Tag="KeyboardTestOverlay"
                                                     IsReadOnly="True"
                                                     Focusable="False"
                                                     Cursor="Hand"
                                                     Text="{Binding Settings.KeyboardTestOverlay, Mode=OneWay}"
                                                     PreviewMouseDown="HotkeyBox_PreviewMouseDown"
                                                     LostKeyboardFocus="HotkeyBox_LostKeyboardFocus"
                                                     PreviewKeyDown="HotkeyBox_PreviewKeyDown"
                                                     PreviewKeyUp="HotkeyBox_PreviewKeyUp" />
                                            <Button Grid.Column="2"
                                                    Content="{Binding [Delete], Source={x:Static services:LocalizationService.Current}}"
                                                    Tag="KeyboardTestOverlay"
                                                    Width="62"
                                                    Height="38"
                                                    Margin="10,0,0,0"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    Click="DeleteHotkey_Click" />
                                        </Grid>
                                    </Grid>
                                </Border>

                                <Border x:Name="GamepadHotkeyCard"
                                        Style="{StaticResource CardStyle}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="12" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse x:Name="GamepadConnectedDot"
                                                     Width="10"
                                                     Height="10"
                                                     Margin="0,5,11,0"
                                                     VerticalAlignment="Top"
                                                     Fill="#58D68D"
                                                     Opacity="0">
                                                <Ellipse.Effect>
                                                    <DropShadowEffect BlurRadius="12"
                                                                      ShadowDepth="0"
                                                                      Opacity="0.46"
                                                                      Color="#58D68D" />
                                                </Ellipse.Effect>
                                            </Ellipse>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock x:Name="GamepadStatusTitleText"
                                                           Text="{Binding [GamepadNotDetected], Source={x:Static services:LocalizationService.Current}}"
                                                           Style="{StaticResource SectionTitleStyle}" />
                                                <TextBlock x:Name="GamepadStatusDescriptionText"
                                                           Text="{Binding [GamepadNotDetectedDescription], Source={x:Static services:LocalizationService.Current}}"
                                                           Margin="0,5,0,0"
                                                           Style="{StaticResource BodyTextStyle}" />
                                            </StackPanel>
                                        </Grid>

                                        <StackPanel Grid.Column="1"
                                                    Orientation="Horizontal"
                                                    VerticalAlignment="Top">
                                            <ComboBox x:Name="GamepadDeviceSelector"
                                                      Width="190"
                                                      Margin="0,0,10,0"
                                                      DisplayMemberPath="DisplayName"
                                                      Visibility="Collapsed"
                                                      SelectionChanged="GamepadDeviceSelector_SelectionChanged" />
                                            <Button Content="{Binding [RefreshGamepads], Source={x:Static services:LocalizationService.Current}}"
                                                    Width="88"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    Click="RefreshGamepads_Click" />
                                        </StackPanel>

                                        <Grid x:Name="GamepadBindingsHost"
                                              Grid.Row="2"
                                              Grid.ColumnSpan="2"
                                              Visibility="Collapsed"
                                              Opacity="0"
                                              RenderTransformOrigin="0.5,0">
                                            <Grid.RenderTransform>
                                                <ScaleTransform x:Name="GamepadBindingsHostScale"
                                                                ScaleX="1"
                                                                ScaleY="0.96" />
                                            </Grid.RenderTransform>
                                            <StackPanel>
                                                <TextBlock Text="{Binding [GamepadShortcuts], Source={x:Static services:LocalizationService.Current}}"
                                                           Style="{StaticResource SectionTitleStyle}" />
                                                <TextBlock Text="{Binding [GamepadShortcutsDescription], Source={x:Static services:LocalizationService.Current}}"
                                                           Margin="0,5,0,12"
                                                           Style="{StaticResource BodyTextStyle}" />
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="8" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="8" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="8" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="170" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding [PreviousTrack], Source={x:Static services:LocalizationService.Current}}"
                                                                       Style="{StaticResource ValueTextStyle}" />
                                                            <TextBlock Text="{Binding [PreviousTrackDescription], Source={x:Static services:LocalizationService.Current}}"
                                                                       Margin="0,4,0,0"
                                                                       Style="{StaticResource CaptionTextStyle}" />
                                                        </StackPanel>
                                                        <TextBox x:Name="GamepadPreviousBox"
                                                                 Grid.Column="1"
                                                                 Tag="PreviousTrack"
                                                                 IsReadOnly="True"
                                                                 Focusable="False"
                                                                 Cursor="Hand"
                                                                 PreviewMouseDown="GamepadBindingBox_PreviewMouseDown"
                                                                 PreviewKeyDown="GamepadBindingBox_PreviewKeyDown" />
                                                        <Button Grid.Column="2"
                                                                Content="{Binding [Clear], Source={x:Static services:LocalizationService.Current}}"
                                                                Tag="PreviousTrack"
                                                                Width="62"
                                                                Height="38"
                                                                Margin="10,0,0,0"
                                                                Style="{StaticResource SecondaryButtonStyle}"
                                                                Click="ClearGamepadBinding_Click" />
                                                    </Grid>
                                                    <Grid Grid.Row="2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="170" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding [NextTrack], Source={x:Static services:LocalizationService.Current}}"
                                                                       Style="{StaticResource ValueTextStyle}" />
                                                            <TextBlock Text="{Binding [NextTrackDescription], Source={x:Static services:LocalizationService.Current}}"
                                                                       Margin="0,4,0,0"
                                                                       Style="{StaticResource CaptionTextStyle}" />
                                                        </StackPanel>
                                                        <TextBox x:Name="GamepadNextBox"
                                                                 Grid.Column="1"
                                                                 Tag="NextTrack"
                                                                 IsReadOnly="True"
                                                                 Focusable="False"
                                                                 Cursor="Hand"
                                                                 PreviewMouseDown="GamepadBindingBox_PreviewMouseDown"
                                                                 PreviewKeyDown="GamepadBindingBox_PreviewKeyDown" />
                                                        <Button Grid.Column="2"
                                                                Content="{Binding [Clear], Source={x:Static services:LocalizationService.Current}}"
                                                                Tag="NextTrack"
                                                                Width="62"
                                                                Height="38"
                                                                Margin="10,0,0,0"
                                                                Style="{StaticResource SecondaryButtonStyle}"
                                                                Click="ClearGamepadBinding_Click" />
                                                    </Grid>
                                                    <Grid Grid.Row="4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="170" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding [TogglePlayPause], Source={x:Static services:LocalizationService.Current}}"
                                                                       Style="{StaticResource ValueTextStyle}" />
                                                            <TextBlock Text="{Binding [TogglePlayPauseDescription], Source={x:Static services:LocalizationService.Current}}"
                                                                       Margin="0,4,0,0"
                                                                       Style="{StaticResource CaptionTextStyle}" />
                                                        </StackPanel>
                                                        <TextBox x:Name="GamepadToggleBox"
                                                                 Grid.Column="1"
                                                                 Tag="TogglePlayPause"
                                                                 IsReadOnly="True"
                                                                 Focusable="False"
                                                                 Cursor="Hand"
                                                                 PreviewMouseDown="GamepadBindingBox_PreviewMouseDown"
                                                                 PreviewKeyDown="GamepadBindingBox_PreviewKeyDown" />
                                                        <Button Grid.Column="2"
                                                                Content="{Binding [Clear], Source={x:Static services:LocalizationService.Current}}"
                                                                Tag="TogglePlayPause"
                                                                Width="62"
                                                                Height="38"
                                                                Margin="10,0,0,0"
                                                                Style="{StaticResource SecondaryButtonStyle}"
                                                                Click="ClearGamepadBinding_Click" />
                                                    </Grid>
                                                    <Grid Grid.Row="6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="170" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding [ShowOverlay], Source={x:Static services:LocalizationService.Current}}"
                                                                       Style="{StaticResource ValueTextStyle}" />
                                                            <TextBlock Text="{Binding [ShowOverlayDescription], Source={x:Static services:LocalizationService.Current}}"
                                                                       Margin="0,4,0,0"
                                                                       Style="{StaticResource CaptionTextStyle}" />
                                                        </StackPanel>
                                                        <TextBox x:Name="GamepadShowCurrentBox"
                                                                 Grid.Column="1"
                                                                 Tag="ShowCurrentTrack"
                                                                 IsReadOnly="True"
                                                                 Focusable="False"
                                                                 Cursor="Hand"
                                                                 PreviewMouseDown="GamepadBindingBox_PreviewMouseDown"
                                                                 PreviewKeyDown="GamepadBindingBox_PreviewKeyDown" />
                                                        <Button Grid.Column="2"
                                                                Content="{Binding [Clear], Source={x:Static services:LocalizationService.Current}}"
                                                                Tag="ShowCurrentTrack"
                                                                Width="62"
                                                                Height="38"
                                                                Margin="10,0,0,0"
                                                                Style="{StaticResource SecondaryButtonStyle}"
                                                                Click="ClearGamepadBinding_Click" />
                                                    </Grid>
                                                </Grid>
                                            </StackPanel>
                                            <StackPanel Visibility="Collapsed">
                                                <TextBlock Text="{Binding [GamepadShortcuts], Source={x:Static services:LocalizationService.Current}}"
                                                           Style="{StaticResource SectionTitleStyle}" />
                                                <TextBlock Text="{Binding [GamepadFutureDescription], Source={x:Static services:LocalizationService.Current}}"
                                                           Margin="0,5,0,0"
                                                           Style="{StaticResource BodyTextStyle}" />
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </TabItem>

                <TabItem>
                    <TabItem.Header>
                        <views:ExpandableNavigationCard x:Name="GeneralNavigationCard"
                                                        Header="{Binding [NavGeneral], Source={x:Static services:LocalizationService.Current}}"
                                                        Style="{StaticResource ExpandableNavigationCardStyle}" />
                    </TabItem.Header>
                    <ScrollViewer Style="{StaticResource PanelScrollViewerStyle}">
                        <Grid Style="{StaticResource FadePageStyle}">
                            <StackPanel>
                                <TextBlock Text="{Binding [GeneralPageTitle], Source={x:Static services:LocalizationService.Current}}"
                                           Style="{StaticResource PageTitleStyle}" />
                                <TextBlock Text="{Binding [GeneralPageDescription], Source={x:Static services:LocalizationService.Current}}"
                                           Margin="0,5,0,16"
                                           Style="{StaticResource BodyTextStyle}" />

                                <Border Style="{StaticResource CardStyle}"
                                        Margin="0,0,0,14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="220" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding [Language], Source={x:Static services:LocalizationService.Current}}"
                                                       Style="{StaticResource SectionTitleStyle}" />
                                            <TextBlock Text="{Binding [LanguageDescription], Source={x:Static services:LocalizationService.Current}}"
                                                       Margin="0,5,0,0"
                                                       Style="{StaticResource BodyTextStyle}" />
                                        </StackPanel>
                                        <ComboBox x:Name="LanguageCombo"
                                                  Grid.Column="1"
                                                  VerticalAlignment="Center"
                                                  DisplayMemberPath="DisplayName"
                                                  SelectedValuePath="LanguageCode"
                                                  SelectionChanged="LanguageCombo_SelectionChanged" />
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource CardStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding [WindowBehavior], Source={x:Static services:LocalizationService.Current}}"
                                                       Style="{StaticResource SectionTitleStyle}" />
                                            <TextBlock Text="{Binding [CloseToTrayDescription], Source={x:Static services:LocalizationService.Current}}"
                                                       Margin="0,5,0,0"
                                                       Style="{StaticResource BodyTextStyle}" />
                                        </StackPanel>
                                        <CheckBox Grid.Column="1"
                                                  Content="{Binding [CloseToTray], Source={x:Static services:LocalizationService.Current}}"
                                                  VerticalAlignment="Center"
                                                  IsChecked="{Binding Settings.CloseToTray, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  Checked="GeneralSetting_Changed"
                                                  Unchecked="GeneralSetting_Changed" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>
    </Border>
</Window>
