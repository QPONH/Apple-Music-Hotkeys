<Window x:Class="AppleMusicOverlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Apple Music Overlay"
        Width="820"
        Height="520"
        MinWidth="720"
        MinHeight="460"
        Background="#0F1116">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel>
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="Apple Music Overlay"
                           Foreground="#F7F8FB"
                           FontFamily="Segoe UI Variable Display, Segoe UI"
                           FontSize="24"
                           FontWeight="SemiBold" />
                <TextBlock Text="{Binding StatusText}"
                           Margin="0,5,0,0"
                           Foreground="#9DA6B6"
                           FontSize="12" />
            </StackPanel>

            <StackPanel DockPanel.Dock="Right"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="刷新"
                        Width="76"
                        Margin="0,0,8,0"
                        Click="Refresh_Click" />
                <Button Content="测试显示"
                        Width="96"
                        Click="TestOverlay_Click" />
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1"
              Margin="0,24,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="22" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Background="#171B23"
                    BorderBrush="#283140"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">
                <StackPanel>
                    <TextBlock Text="当前播放"
                               Foreground="#9DA6B6"
                               FontSize="12"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{Binding CurrentTitle}"
                               Margin="0,18,0,0"
                               Foreground="#F7F8FB"
                               FontFamily="Segoe UI Variable Display, Segoe UI"
                               FontSize="21"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding CurrentArtist}"
                               Margin="0,8,0,0"
                               Foreground="#B6BDCA"
                               FontSize="13"
                               TextWrapping="Wrap" />

                    <Separator Margin="0,22,0,16"
                               Background="#283140" />

                    <UniformGrid Columns="3">
                        <Button Content="上一首"
                                Margin="0,0,6,0"
                                Click="Previous_Click" />
                        <Button Content="播放"
                                Margin="3,0"
                                Click="Toggle_Click" />
                        <Button Content="下一首"
                                Margin="6,0,0,0"
                                Click="Next_Click" />
                    </UniformGrid>
                </StackPanel>
            </Border>

            <Border Grid.Column="2"
                    Background="#171B23"
                    BorderBrush="#283140"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="显示"
                               Foreground="#F7F8FB"
                               FontSize="16"
                               FontWeight="SemiBold" />

                    <WrapPanel Grid.Row="1"
                               Margin="0,14,0,20">
                        <CheckBox Content="歌名"
                                  Margin="0,0,18,0"
                                  IsChecked="{Binding Settings.ShowTitle}" />
                        <CheckBox Content="歌手"
                                  Margin="0,0,18,0"
                                  IsChecked="{Binding Settings.ShowArtist}" />
                        <CheckBox Content="常驻显示"
                                  IsChecked="{Binding Settings.PauseOverlay}" />
                    </WrapPanel>

                    <Grid Grid.Row="2"
                          Margin="0,0,0,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="显示秒数"
                                       Foreground="#9DA6B6"
                                       FontSize="12" />
                            <Slider Minimum="1"
                                    Maximum="10"
                                    TickFrequency="1"
                                    IsSnapToTickEnabled="True"
                                    Value="{Binding Settings.DisplaySeconds}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="缩放"
                                       Foreground="#9DA6B6"
                                       FontSize="12" />
                            <Slider Minimum="70"
                                    Maximum="180"
                                    TickFrequency="5"
                                    IsSnapToTickEnabled="True"
                                    Value="{Binding Settings.ScalePercent}" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="38" />
                            <RowDefinition Height="38" />
                            <RowDefinition Height="38" />
                            <RowDefinition Height="38" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="上一首"
                                   Foreground="#B6BDCA"
                                   VerticalAlignment="Center" />
                        <TextBox Grid.Column="1"
                                 Text="{Binding Settings.KeyboardPrevious, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="1"
                                   Text="下一首"
                                   Foreground="#B6BDCA"
                                   VerticalAlignment="Center" />
                        <TextBox Grid.Row="1"
                                 Grid.Column="1"
                                 Text="{Binding Settings.KeyboardNext, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="2"
                                   Text="播放/暂停"
                                   Foreground="#B6BDCA"
                                   VerticalAlignment="Center" />
                        <TextBox Grid.Row="2"
                                 Grid.Column="1"
                                 Text="{Binding Settings.KeyboardToggle, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="3"
                                   Text="测试显示"
                                   Foreground="#B6BDCA"
                                   VerticalAlignment="Center" />
                        <TextBox Grid.Row="3"
                                 Grid.Column="1"
                                 Text="{Binding Settings.KeyboardTestOverlay, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>

                    <StackPanel Grid.Row="4"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <CheckBox Content="关闭到托盘"
                                  Margin="0,0,18,0"
                                  VerticalAlignment="Center"
                                  IsChecked="{Binding Settings.CloseToTray}" />
                        <Button Content="保存"
                                Width="86"
                                Click="Save_Click" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <TextBlock Grid.Row="2"
                   Text="本地运行 · 无注入 · SMTC"
                   Foreground="#6F7888"
                   FontSize="11" />
    </Grid>
</Window>
