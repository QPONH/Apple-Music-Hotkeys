<Window x:Class="AppleMusicOverlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MusicFloat"
        Width="1040"
        Height="660"
        MinWidth="900"
        MinHeight="580"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="#0F1116">
    <Window.Resources>
        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#0F1116" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#171B23" />
        <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#1D2330" />
        <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#252C39" />
        <SolidColorBrush x:Key="SurfacePressedBrush" Color="#121722" />
        <SolidColorBrush x:Key="StrokeBrush" Color="#2D3646" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F7F8FB" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#AEB7C8" />
        <SolidColorBrush x:Key="TextMutedBrush" Color="#6F7888" />
        <SolidColorBrush x:Key="AccentBrush" Color="#B9D4FF" />

        <Style x:Key="RoundButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1" />
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="18">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="#3B4658" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource SurfacePressedBrush}" />
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.985" ScaleY="0.985" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource RoundButtonStyle}">
            <Setter Property="Background" Value="#2B5A92" />
            <Setter Property="BorderBrush" Value="#3C70AA" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>

        <Style x:Key="TransportButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource RoundButtonStyle}">
            <Setter Property="Width" Value="92" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style x:Key="WindowButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#252C39" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#30394A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type TextBox}">
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="#111720" />
            <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CaretBrush" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="#3B4658" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="#5F82B4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ComboBox}">
            <Setter Property="Height" Value="42" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="#111720" />
            <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,0" />
        </Style>

        <Style TargetType="{x:Type CheckBox}">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CheckBox}">
                        <Border x:Name="Chip"
                                Padding="13,8"
                                Background="#111720"
                                BorderBrush="{StaticResource StrokeBrush}"
                                BorderThickness="1"
                                CornerRadius="16">
                            <StackPanel Orientation="Horizontal">
                                <Border x:Name="Mark"
                                        Width="16"
                                        Height="16"
                                        Margin="0,0,8,0"
                                        Background="#202736"
                                        BorderBrush="#465268"
                                        BorderThickness="1"
                                        CornerRadius="5">
                                    <Path x:Name="Check"
                                          Data="M 3 8 L 7 12 L 13 4"
                                          Stroke="#FFFFFF"
                                          StrokeThickness="2"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          Visibility="Collapsed" />
                                </Border>
                                <ContentPresenter VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="#1D2330" />
                                <Setter TargetName="Chip" Property="BorderBrush" Value="#3B4658" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="#24334A" />
                                <Setter TargetName="Chip" Property="BorderBrush" Value="#4C74AA" />
                                <Setter TargetName="Mark" Property="Background" Value="#6EA0E8" />
                                <Setter TargetName="Mark" Property="BorderBrush" Value="#8EB8F5" />
                                <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="#151A24" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type Slider}">
            <Setter Property="Height" Value="32" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Slider}">
                        <Grid>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton IsTabStop="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="{x:Type RepeatButton}">
                                                <Border Height="6"
                                                        VerticalAlignment="Center"
                                                        Background="#6EA0E8"
                                                        CornerRadius="3" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton IsTabStop="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="{x:Type RepeatButton}">
                                                <Border Height="6"
                                                        VerticalAlignment="Center"
                                                        Background="#30394A"
                                                        CornerRadius="3" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="18"
                                           Height="18">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Ellipse Fill="#F7F8FB"
                                                         Stroke="#AEB7C8"
                                                         StrokeThickness="1">
                                                    <Ellipse.Effect>
                                                        <DropShadowEffect BlurRadius="10"
                                                                          ShadowDepth="2"
                                                                          Opacity="0.38"
                                                                          Color="#000000" />
                                                    </Ellipse.Effect>
                                                </Ellipse>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource AppBackgroundBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="58" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  Margin="22,12,14,6"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Border Width="34"
                            Height="34"
                            Margin="0,0,12,0"
                            CornerRadius="12"
                            Background="#1F2A3A"
                            BorderBrush="#33425A"
                            BorderThickness="1">
                        <TextBlock Text="♪"
                                   Foreground="{StaticResource AccentBrush}"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel>
                        <TextBlock Text="MusicFloat"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontFamily="Segoe UI Variable Display, Segoe UI"
                                   FontSize="21"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{Binding StatusText}"
                                   Margin="0,1,0,0"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="11" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Content="—"
                            Style="{StaticResource WindowButtonStyle}"
                            Click="Minimize_Click" />
                    <Button Content="□"
                            Style="{StaticResource WindowButtonStyle}"
                            Click="Maximize_Click" />
                    <Button Content="×"
                            Style="{StaticResource WindowButtonStyle}"
                            Click="Close_Click" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1"
                  Margin="22,8,22,22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="310" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource StrokeBrush}"
                        BorderThickness="1"
                        CornerRadius="22"
                        Padding="22">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel>
                            <TextBlock Text="正在播放"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="12"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{Binding CurrentTitle}"
                                       Margin="0,22,0,0"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontFamily="Segoe UI Variable Display, Segoe UI"
                                       FontSize="28"
                                       FontWeight="Bold"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{Binding CurrentArtist}"
                                       Margin="0,8,0,0"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="15"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <Border Grid.Row="1"
                                Margin="0,26,0,22"
                                Background="#111720"
                                CornerRadius="18"
                                BorderBrush="#252E3D"
                                BorderThickness="1">
                            <Grid>
                                <Ellipse Width="112"
                                         Height="112"
                                         Fill="#24334A"
                                         Opacity="0.76"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center" />
                                <TextBlock Text="♪"
                                           Foreground="{StaticResource AccentBrush}"
                                           FontSize="54"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <UniformGrid Grid.Row="2"
                                     Columns="3">
                            <Button Content="上一首"
                                    Style="{StaticResource TransportButtonStyle}"
                                    Margin="0,0,7,0"
                                    Click="Previous_Click" />
                            <Button Content="{Binding TransportButtonText}"
                                    Style="{StaticResource TransportButtonStyle}"
                                    Margin="4,0"
                                    Click="Toggle_Click" />
                            <Button Content="下一首"
                                    Style="{StaticResource TransportButtonStyle}"
                                    Margin="7,0,0,0"
                                    Click="Next_Click" />
                        </UniformGrid>
                    </Grid>
                </Border>

                <Border Grid.Column="2"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource StrokeBrush}"
                        BorderThickness="1"
                        CornerRadius="22"
                        Padding="24">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="控制台"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           FontFamily="Segoe UI Variable Display, Segoe UI"
                                           FontSize="24"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="调整悬浮显示、媒体源和快捷键"
                                           Margin="0,5,0,0"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           FontSize="12" />
                            </StackPanel>
                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal">
                                <Button Content="刷新"
                                        Width="88"
                                        Style="{StaticResource RoundButtonStyle}"
                                        Margin="0,0,10,0"
                                        Click="Refresh_Click" />
                                <Button Content="显示当前"
                                        Width="112"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Click="ShowCurrentTrack_Click" />
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="1"
                              Margin="0,28,0,24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="104" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="抓取源"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,8" />
                                <ComboBox x:Name="CaptureSourceCombo"
                                          ItemsSource="{Binding CaptureSources}"
                                          DisplayMemberPath="DisplayName"
                                          SelectedValuePath="SourceAppUserModelId"
                                          SelectedValue="{Binding Settings.CaptureSourceAppUserModelId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          SelectionChanged="CaptureSourceCombo_SelectionChanged" />
                            </StackPanel>
                            <Button Grid.Column="2"
                                    Content="刷新源"
                                    Style="{StaticResource RoundButtonStyle}"
                                    VerticalAlignment="Bottom"
                                    Click="RefreshSources_Click" />
                        </Grid>

                        <StackPanel Grid.Row="2"
                                    Margin="0,0,0,24">
                            <TextBlock Text="显示内容"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,10" />
                            <WrapPanel>
                                <CheckBox Content="歌名"
                                          Margin="0,0,10,10"
                                          IsChecked="{Binding Settings.ShowTitle}" />
                                <CheckBox Content="歌手"
                                          Margin="0,0,10,10"
                                          IsChecked="{Binding Settings.ShowArtist}" />
                                <CheckBox Content="常驻显示"
                                          Margin="0,0,10,10"
                                          IsChecked="{Binding Settings.PauseOverlay}" />
                            </WrapPanel>
                        </StackPanel>

                        <Grid Grid.Row="3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.05*" />
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock Text="显示秒数"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               FontSize="12" />
                                    <TextBlock DockPanel.Dock="Right"
                                               Text="{Binding ElementName=DisplaySecondsSlider, Path=Value, StringFormat={}{0:0} 秒}"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               FontSize="12"
                                               FontWeight="SemiBold" />
                                </DockPanel>
                                <Slider x:Name="DisplaySecondsSlider"
                                        Minimum="1"
                                        Maximum="10"
                                        TickFrequency="1"
                                        IsSnapToTickEnabled="True"
                                        Value="{Binding Settings.DisplaySeconds}"
                                        ValueChanged="SettingsControl_Changed" />

                                <DockPanel Margin="0,22,0,6">
                                    <TextBlock Text="缩放"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               FontSize="12" />
                                    <TextBlock DockPanel.Dock="Right"
                                               Text="{Binding ElementName=ScaleSlider, Path=Value, StringFormat={}{0:0}%}"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               FontSize="12"
                                               FontWeight="SemiBold" />
                                </DockPanel>
                                <Slider x:Name="ScaleSlider"
                                        Minimum="70"
                                        Maximum="180"
                                        TickFrequency="5"
                                        IsSnapToTickEnabled="True"
                                        Value="{Binding Settings.ScalePercent}"
                                        ValueChanged="SettingsControl_Changed" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="快捷键"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,10" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="82" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="48" />
                                        <RowDefinition Height="48" />
                                        <RowDefinition Height="48" />
                                        <RowDefinition Height="48" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="上一首"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1"
                                             Text="{Binding Settings.KeyboardPrevious, UpdateSourceTrigger=PropertyChanged}" />

                                    <TextBlock Grid.Row="1"
                                               Text="下一首"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               VerticalAlignment="Center" />
                                    <TextBox Grid.Row="1"
                                             Grid.Column="1"
                                             Text="{Binding Settings.KeyboardNext, UpdateSourceTrigger=PropertyChanged}" />

                                    <TextBlock Grid.Row="2"
                                               Text="播放"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               VerticalAlignment="Center" />
                                    <TextBox Grid.Row="2"
                                             Grid.Column="1"
                                             Text="{Binding Settings.KeyboardToggle, UpdateSourceTrigger=PropertyChanged}" />

                                    <TextBlock Grid.Row="3"
                                               Text="显示"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               VerticalAlignment="Center" />
                                    <TextBox Grid.Row="3"
                                             Grid.Column="1"
                                             Text="{Binding Settings.KeyboardTestOverlay, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="4"
                              Margin="0,18,0,0">
                            <CheckBox Content="关闭到托盘"
                                      HorizontalAlignment="Left"
                                      VerticalAlignment="Center"
                                      IsChecked="{Binding Settings.CloseToTray}" />
                            <Button Content="保存设置"
                                    Width="118"
                                    HorizontalAlignment="Right"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Click="Save_Click" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
