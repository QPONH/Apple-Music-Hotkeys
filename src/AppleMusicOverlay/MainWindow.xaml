<Window x:Class="AppleMusicOverlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MusicFloat"
        Width="720"
        Height="620"
        MinWidth="620"
        MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="#10141B"
        Foreground="#F5F7FA"
        Closing="Window_Closing">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="MusicFloat" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Text="Apple Music 全局快捷键控制" Margin="0,6,0,0" Foreground="#AEB7C5" FontSize="14" />
        </StackPanel>

        <Border Grid.Row="1" Margin="0,22,0,16" Padding="16" CornerRadius="12" Background="#171D27" BorderBrush="#2D3746" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="快捷键" FontSize="17" FontWeight="SemiBold" />
                <TextBlock Text="点击输入框后直接按下组合键，松开按键后自动保存。" Margin="0,5,0,0" Foreground="#AEB7C5" />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="90" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="52" />
                    <RowDefinition Height="52" />
                    <RowDefinition Height="52" />
                    <RowDefinition Height="52" />
                    <RowDefinition Height="52" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="上一曲" VerticalAlignment="Center" FontSize="14" />
                <TextBox x:Name="PreviousBox" Grid.Row="0" Grid.Column="1" Tag="PreviousTrack"
                         PreviewMouseDown="HotkeyBox_PreviewMouseDown" PreviewKeyDown="HotkeyBox_PreviewKeyDown"
                         PreviewKeyUp="HotkeyBox_PreviewKeyUp" />
                <Button Grid.Row="0" Grid.Column="2" Margin="10,0,0,0" Content="清除" Tag="PreviousTrack" Click="DeleteHotkey_Click" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="下一曲" VerticalAlignment="Center" FontSize="14" />
                <TextBox x:Name="NextBox" Grid.Row="1" Grid.Column="1" Tag="NextTrack"
                         PreviewMouseDown="HotkeyBox_PreviewMouseDown" PreviewKeyDown="HotkeyBox_PreviewKeyDown"
                         PreviewKeyUp="HotkeyBox_PreviewKeyUp" />
                <Button Grid.Row="1" Grid.Column="2" Margin="10,0,0,0" Content="清除" Tag="NextTrack" Click="DeleteHotkey_Click" />

                <TextBlock Grid.Row="2" Grid.Column="0" Text="播放 / 暂停" VerticalAlignment="Center" FontSize="14" />
                <TextBox x:Name="ToggleBox" Grid.Row="2" Grid.Column="1" Tag="TogglePlayPause"
                         PreviewMouseDown="HotkeyBox_PreviewMouseDown" PreviewKeyDown="HotkeyBox_PreviewKeyDown"
                         PreviewKeyUp="HotkeyBox_PreviewKeyUp" />
                <Button Grid.Row="2" Grid.Column="2" Margin="10,0,0,0" Content="清除" Tag="TogglePlayPause" Click="DeleteHotkey_Click" />

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Apple Music 音量 +5%" VerticalAlignment="Center" FontSize="14" />
                <TextBox x:Name="VolumeUpBox" Grid.Row="3" Grid.Column="1" Tag="VolumeUp"
                         PreviewMouseDown="HotkeyBox_PreviewMouseDown" PreviewKeyDown="HotkeyBox_PreviewKeyDown"
                         PreviewKeyUp="HotkeyBox_PreviewKeyUp" />
                <Button Grid.Row="3" Grid.Column="2" Margin="10,0,0,0" Content="清除" Tag="VolumeUp" Click="DeleteHotkey_Click" />

                <TextBlock Grid.Row="4" Grid.Column="0" Text="Apple Music 音量 -5%" VerticalAlignment="Center" FontSize="14" />
                <TextBox x:Name="VolumeDownBox" Grid.Row="4" Grid.Column="1" Tag="VolumeDown"
                         PreviewMouseDown="HotkeyBox_PreviewMouseDown" PreviewKeyDown="HotkeyBox_PreviewKeyDown"
                         PreviewKeyUp="HotkeyBox_PreviewKeyUp" />
                <Button Grid.Row="4" Grid.Column="2" Margin="10,0,0,0" Content="清除" Tag="VolumeDown" Click="DeleteHotkey_Click" />
            </Grid>
        </ScrollViewer>

        <Border Grid.Row="3" Margin="0,20,0,0" Padding="16" CornerRadius="12" Background="#171D27" BorderBrush="#2D3746" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <CheckBox x:Name="CloseToTrayCheckBox" Grid.Row="0" Content="点击窗口关闭按钮时隐藏到托盘，而不是退出程序"
                          IsChecked="True" Checked="CloseToTray_Changed" Unchecked="CloseToTray_Changed" />
                <CheckBox x:Name="HideOnStartupCheckBox" Grid.Row="1" Margin="0,10,0,0" Content="启动后自动隐藏设置窗口"
                          Checked="HideOnStartup_Changed" Unchecked="HideOnStartup_Changed" />
                <TextBlock x:Name="StatusText" Grid.Row="2" Margin="0,12,0,0" Foreground="#7FD0D9" />
            </Grid>
        </Border>
    </Grid>
</Window>
